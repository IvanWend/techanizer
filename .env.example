# Copy to .env and fill in. .env is git-ignored — never commit it.

# Postgres. Read by docker-compose.yml as ${POSTGRES_PASSWORD:-devpassword};
# if unset, the container silently falls back to that default.
POSTGRES_PASSWORD=change-me

# LLM — needed from Phase 2 (extraction) onward, and Phase 4 (agent).
DEEPSEEK_API_KEY=

# Agent + extraction + embeddings + judge models: Alibaba Cloud Model Studio (DashScope) —
# stage 1 GLM 5.3, stage 2 Qwen 3.8 Flash, extraction DeepSeek V4.1 Flash, embeddings
# Qwen3 text-embedding-v4, judge/labeler GLM 5.3.
# This is a China-region key; the app resolves alibaba:* against the China
# compatible-mode endpoint (dashscope.aliyuncs.com), not the intl default.
ALIBABA_API_KEY=

# Web3.career ingestion. Free but email-gated. Without a valid token the API
# redirects to the sales page instead of returning an error.
WEB3_API_KEY=

# Postgres connection string used by the ingestion loader.
# Must match POSTGRES_PASSWORD above — psycopg takes this string directly.
DATABASE_URL=postgresql://techanizer:change-me@localhost:5432/techanizer

# Frozen eval snapshot (Phase 1b), restored into a second database in the same
# container. Deliberately a different role: techanizer_ro holds SELECT only, so
# the snapshot cannot drift no matter what connects to it.
EVAL_DATABASE_URL=postgresql://techanizer_ro:change-me-too@localhost:5432/techanizer_eval

# Langfuse tracing (Phase 2). Absent keys are not an error — configure_tracing()
# returns None and the pipeline runs untraced.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com  US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Agent-loop guardrails (Phase 5). Optional; the defaults are the values shown.
# request_limit = max model turns, tool_calls_limit = max tool calls; the token
# limits are the spend cap (pydantic-ai has no DeepSeek cost, so no cost_limit).
AGENT_MAX_REQUESTS=10
AGENT_MAX_TOOL_CALLS=6
AGENT_TOTAL_TOKENS=300000
AGENT_OUTPUT_TOKENS=10000

# Per-IP rate limit on /ask (Phase 5). Requests per window; 429 + Retry-After
# when exceeded. In-process only — resets on restart.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60
